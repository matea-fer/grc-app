# Obavezno
DB_PASSWORD=postavi_svoju_lozinku_ovdje
# Tajna za potpisivanje JWT-a - najmanje 32 znaka (HS256 trazi 256 bitova).
# Generiraj nasumican niz, npr.: openssl rand -base64 48
JWT_SECRET=postavi_dugu_nasumicnu_tajnu_od_najmanje_32_znaka

# Opcionalno - odkomentiraj i promijeni ako se tvoja lokalna baza razlikuje od defaulta
#DB_NAME=demo_db
#DB_USER=postgres
#DB_PORT=5432

# Opcionalno - prijava
#JWT_EXPIRY_HOURS=8
# Lozinka pocetnog ADMIN racuna (korisnicko ime je "admin"). Vrijedi samo pri prvom
# pokretanju, dok u bazi jos nema nijednog korisnika.
#SEED_ADMIN_PASSWORD=admin
