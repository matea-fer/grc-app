# Kopiraj na serveru u .env i popuni PRAVIM vrijednostima (ovo NIJE u gitu).
#   cp .env.prod.example .env   &&   nano .env

# Baza
DB_NAME=grc_db
DB_USER=postgres
DB_PASSWORD=BurekKodIve350

# JWT tajna - najmanje 32 znaka. Generiraj npr.:  openssl rand -base64 48
JWT_SECRET=PROMIJENI_ME_najmanje_32_znaka_nasumicno

# Vlasnik GHCR slika (GitHub korisnik/organizacija) i verzija koja se deploya.
GH_OWNER=matea-fer
TAG=latest

# JVM heap na malom Dropletu (uz swap). Povecaj ako ima vise RAM-a.
JAVA_OPTS=-Xmx256m
