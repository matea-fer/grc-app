# DigitalOcean Spaces (S3-kompatibilno). Kopiraj u ops/backup.env i popuni.
# ops/backup.env NIJE u gitu (sadrzi kljuceve).
#
#   cp ops/backup.env.example ops/backup.env  &&  nano ops/backup.env

SPACES_BUCKET=grc-app-backups
SPACES_ENDPOINT=fra1.digitaloceanspaces.com
SPACES_REGION=fra1
AWS_ACCESS_KEY_ID=tvoj_spaces_access_key
AWS_SECRET_ACCESS_KEY=tvoj_spaces_secret_key
# Koliko dana cuvati LOKALne dumpove na Dropletu (Spaces retenciju rijesi lifecycle pravilom).
RETENTION_DAYS=7
