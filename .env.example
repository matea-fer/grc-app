# Postavke za docker-compose (baza ove aplikacije).
# Kopiraj u .env: cp .env.example .env
# Drži iste vrijednosti kao u backend/.env da se app i baza slažu.

# Svaka aplikacija dobiva SVOJU bazu i SVOJ port. Ako dižeš više aplikacija
# paralelno, daj svakoj jedinstven DB_PORT (5432, 5433, 5434 ...).
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=postavi_svoju_lozinku_ovdje
