# Lokalni staging - kopiraj u .env.staging (NIJE u gitu) i po zelji promijeni.
# Ovo su LOKALNE vrijednosti (throwaway), ne diraju prod.
DB_NAME=grc_stage
DB_USER=postgres
DB_PASSWORD=stage_pw
# JWT za staging - bilo koja >=32 znaka; nema veze s prod tajnom.
JWT_SECRET=staging-tajna-dovoljno-duga-0123456789
# Kandidat slike s GHCR-a: "edge" = zadnji main build. Mozes staviti i konkretan "sha-xxxxxxx".
GH_OWNER=matea-fer
TAG=edge
# Na kojem portu ce staging frontend biti lokalno (da ne smeta drugim stvarima).
FRONTEND_PORT=8081
JAVA_OPTS=-Xmx512m
